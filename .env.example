# App
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
API_PORT=3000
API_HTTP_PORT=
API_HOST=127.0.0.1
API_HTTPS_ENABLED=false
API_TLS_KEY_PATH=certs/videoflow-app.tk-key.pem
API_TLS_CERT_PATH=certs/videoflow-app.tk.pem
WORKER_CONCURRENCY=2

# Database and queue
DATABASE_URL=postgresql://videoflow:videoflow_password@localhost:5433/videoflow?schema=public
POSTGRES_DB=videoflow
POSTGRES_USER=videoflow
POSTGRES_PASSWORD=videoflow_password
POSTGRES_HOST_PORT=5433
REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6379

# Auth and encryption
JWT_SECRET=replace-with-32-plus-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-plus-random-string
ENCRYPTION_KEY=replace-with-32-byte-base64-aes-key

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VideoFlow <no-reply@videoflow.local>

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=videoflow-videos
R2_PUBLIC_URL=

# YouTube / Google OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URL=http://localhost:3000/oauth/youtube/callback

# VK OAuth
VK_APP_ID=
VK_APP_SECRET=
VK_REDIRECT_URL=http://localhost:3000/oauth/vk/callback

# Meta OAuth: Instagram + Threads
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URL=http://localhost:3000/oauth/meta/callback

# TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URL=http://localhost:3000/oauth/tiktok/callback

# Pinterest OAuth
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URL=http://localhost:3000/oauth/pinterest/callback
